{
  "name": "@intuit-2/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Intuit 2.0 backend — Fastify modular monolith.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "tsx src/database/cli/migrate.ts",
    "db:seed": "tsx src/database/cli/seed.ts",
    "db:setup": "tsx src/database/cli/migrate.ts && tsx src/database/cli/seed.ts",
    "db:seed:dev": "tsx src/database/cli/seed-dev.ts",
    "mfa:rotate-keys": "tsx src/database/cli/mfa-rotate-keys.ts",
    "revaluation:dev-run": "tsx src/database/cli/revaluation-dev-run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@node-rs/argon2": "^2.2.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "qrcode-generator": "2.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
