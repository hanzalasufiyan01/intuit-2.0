# Intuit 2.0 — environment configuration template
# Copy to .env and fill in real values. Placeholders only — never commit real secrets.

# ---- Runtime ----
# One of: development | testing | staging | production
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# Public origin of the web app (used for CORS and cookie settings)
WEB_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Application role: limited privileges (no UPDATE/DELETE on audit tables).
DATABASE_URL=postgres://intuit_app:CHANGE_ME@localhost:5432/intuit_dev
# Migration role: owns the schema and runs migrations.
DATABASE_MIGRATION_URL=postgres://intuit_owner:CHANGE_ME@localhost:5432/intuit_dev
DATABASE_POOL_MAX=10

# ---- Sessions (approved Phase 1 defaults) ----
SESSION_COOKIE_NAME=intuit_session
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_DAYS=7
SENSITIVE_ACTION_REAUTH_MINUTES=15
# Secret used for cookie signing / CSRF. Generate a long random value.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# ---- Passwords ----
PASSWORD_MIN_LENGTH=12

# ---- Login protection ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_WINDOW_MINUTES=15

# ---- Invitations ----
# UNDECIDED: invitation expiry period has not been approved yet.
INVITATION_EXPIRY_DAYS=

# ---- Email provider ----
# mock = development provider that records messages instead of sending them
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.test
