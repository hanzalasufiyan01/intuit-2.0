# Intuit 2.0 — environment configuration template
# Copy to .env and fill in real values. Placeholders only — never commit real secrets.
# .env is git-ignored. Both the API and the test suite read it from the repository root.

# ---- Runtime ----
# One of: development | testing | staging | production
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# One of: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public origin of the web app. State-changing requests from any other Origin are rejected.
# In development the Vite dev server proxies /api to the API, so the browser sees one origin.
WEB_ORIGIN=http://localhost:5173
# true only behind a trusted reverse proxy (client IP taken from X-Forwarded-For)
TRUST_PROXY=false

# ---- Database (PostgreSQL 16, native local service on port 5432) ----
# Development database name: intuit2_dev
# Application role: limited privileges (INSERT/SELECT only on audit and security-event tables).
DATABASE_URL=postgres://intuit_app:CHANGE_ME@localhost:5432/intuit2_dev
# Migration role: owns the schema and runs migrations and catalog seeding.
DATABASE_MIGRATION_URL=postgres://intuit_owner:CHANGE_ME@localhost:5432/intuit2_dev
DATABASE_POOL_MAX=10

# ---- Sessions (approved Phase 1 defaults) ----
SESSION_COOKIE_NAME=intuit_session
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_DAYS=7
SENSITIVE_ACTION_REAUTH_MINUTES=15
# Secret used to derive CSRF tokens. Generate a long random value (at least 32 characters).
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# ---- Passwords ----
PASSWORD_MIN_LENGTH=12
# Lifetime of a password-reset token. APPROVED and FROZEN at 60 minutes (ADR 0001).
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---- Login protection ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILED_WINDOW_MINUTES=15
# Progressive back-off after the threshold: base doubles per extra failure, capped.
LOGIN_BACKOFF_BASE_SECONDS=60
LOGIN_BACKOFF_MAX_SECONDS=900

# ---- Invitations (approved: 72 hours) ----
INVITATION_EXPIRY_HOURS=72

# ---- Outbox dispatcher ----
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20

# ---- Email provider ----
# mock = development provider that records messages instead of sending them
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.test

# ---- Development seed (pnpm db:seed:dev; refused outside development/testing) ----
# Password for the seeded dev users. Local only; at least 12 characters.
DEV_SEED_PASSWORD=
# Authenticator key (base32, 20 random bytes) for the seeded Owner and Administrator (S7).
DEV_SEED_TOTP_SECRET=

# ---- File storage (Phase 3A S5) ----
# local = development provider (files under the git-ignored .data/storage). Production S3-compatible
# storage arrives after library evaluation and approval (Decision 62).
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/storage
# Signed download link lifetime (Decision 76) and deleted-file retention before purge (Decision 29).
FILE_DOWNLOAD_TOKEN_TTL_MINUTES=5
FILE_RETENTION_DAYS=90
FILES_PURGE_INTERVAL_MINUTES=60

# ---- Background jobs (Phase 3A S5; Decisions 20, 76) ----
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=1000
JOBS_CONCURRENCY=2
JOBS_MAX_ATTEMPTS=5
JOBS_BACKOFF_BASE_SECONDS=5
JOBS_BACKOFF_MAX_SECONDS=900
JOBS_STALE_LOCK_MINUTES=10

# ---- Import and export (Phase 3A S6; Decisions 24, 61) ----
# Decision 61 maxima (25,000 rows, 500-row preview, 25 MB files) may be lowered, never raised.
IMPORT_MAX_ROWS=25000
IMPORT_PREVIEW_ROWS=500
IMPORT_MAX_ACTIVE_PER_ORGANIZATION=3
IMPORT_BATCH_EXPIRY_DAYS=7
# Imported source cells and typed values are redacted this many days after an import ends (L-11).
IMPORT_STAGING_RETENTION_DAYS=30
IMPORT_COMMIT_STATEMENT_TIMEOUT_SECONDS=600
IMPORT_COMMIT_LOCK_TIMEOUT_SECONDS=10
EXPORT_MAX_BYTES=26214400
EXPORT_EXPIRY_DAYS=7
DATA_EXCHANGE_CLEANUP_INTERVAL_MINUTES=60

# ---- Multi-factor authentication (Phase 3A S7; Decisions 25, 57, 76) ----
# AES-256-GCM key ring for TOTP secrets: comma-separated keyId:base64(32 random bytes).
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep keys in the environment / secret manager only. To rotate: add a new key, make it active,
# run `pnpm --filter @intuit-2/api mfa:rotate-keys`, then remove the old key.
MFA_ENCRYPTION_KEYS=replace-with-keyId:base64-32-byte-key
MFA_ENCRYPTION_ACTIVE_KEY_ID=replace-with-keyId
MFA_TOTP_ISSUER=Intuit 2.0
# TOTP window in 30-second steps: 1 (Decision 76) or 0; never wider.
MFA_TOTP_WINDOW=1
MFA_RECOVERY_CODE_COUNT=10
MFA_PENDING_TTL_MINUTES=10
MFA_CHALLENGE_MAX_ATTEMPTS=5
MFA_ENROLLMENT_TTL_MINUTES=15
MFA_STEP_UP_MINUTES=15
# Remembered devices: at most 30 days (Decision 57d).
TRUSTED_DEVICE_DAYS=30
TRUSTED_DEVICE_COOKIE_NAME=intuit_trusted_device
TRUSTED_DEVICE_MAX_PER_USER=10
